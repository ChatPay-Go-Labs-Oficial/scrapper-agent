# Configuração do servidor de produção
# Copie este arquivo para .env e ajuste as configurações

# Configurações do servidor
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# Configurações do OpenAI (obrigatório se usando OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Configurações do Ollama (se usando modelo local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Configurações do banco de dados
DATABASE_URL=sqlite:///agno_scraper_agent.db

# Configurações de segurança (para produção)
# SECURITY_KEY=your_secret_key_here
# CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]

# Configurações de rate limiting (opcional)
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# Configurações de logging
LOG_FORMAT=json
LOG_FILE=logs/api.log
