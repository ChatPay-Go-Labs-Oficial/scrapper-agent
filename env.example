# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# Configurações da API (para o chat app)
API_BASE_URL=http://localhost:8000

# ===========================================
# CONFIGURAÇÕES DE API KEYS
# ===========================================

# OpenAI (se usando GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Ollama (se usando modelo local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================

# PostgreSQL (Recomendado para produção)
# Local Docker: postgresql://agno_user:agno_password@localhost:5432/agno_scraper
# Railway: Use a variável DATABASE_URL fornecida automaticamente pelo Railway
DATABASE_URL=postgresql://agno_user:agno_password@postgres:5432/agno_scraper

# Credenciais do PostgreSQL (para docker-compose)
POSTGRES_USER=agno_user
POSTGRES_PASSWORD=agno_password
POSTGRES_DB=agno_scraper
POSTGRES_PORT=5432

# SQLite (alternativa para desenvolvimento local)
# DATABASE_URL=sqlite:///tmp/agno_scraper_agent.db
