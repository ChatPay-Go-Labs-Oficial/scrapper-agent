# Configurações do servidor
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# Configurações da API (para o chat app)
API_BASE_URL=http://localhost:8000

# Configurações do OpenAI (se usando OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Configurações do Ollama (se usando modelo local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Configurações do banco de dados
DATABASE_URL=sqlite:///agno_scraper_agent.db
