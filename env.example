# Configurações do servidor
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# Configurações da API (para o chat app)
API_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# Segurança — autenticação interna
# ──────────────────────────────────────────────
# Token compartilhado entre Backend NestJS e AI Service.
# Geração: openssl rand -hex 32
# NUNCA commitar o valor real. Use Railway Secrets em produção.
AI_SERVICE_INTERNAL_TOKEN=your_internal_token_here

# Origens permitidas no CORS (separadas por vírgula).
# Em desenvolvimento, pode usar http://localhost:3000
# Em produção, usar apenas a URL do Backend NestJS.
ALLOWED_ORIGINS=http://localhost:3000

# Configurações do Google AI
GOOGLE_API_KEY=your_google_api_key_here

# Configurações do OpenAI (se usando OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Modelo Padrão (gemini-2.0-flash ou gpt-4o-mini)
DEFAULT_MODEL=gemini-2.0-flash

# Configurações do Ollama (se usando modelo local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Configurações do banco de dados
DATABASE_URL=sqlite:///agno_scraper_agent.db

# =============================================================================
# WORKER DE INGESTÃO (F1-ING-002)
# =============================================================================
# URL do PostgreSQL (mesmo banco do backend NestJS)
WORKER_DATABASE_URL=postgresql://postgres:root@localhost:5432/chatcheckout

# Redis com senha (para o worker consumir a fila BullMQ)
WORKER_REDIS_URL=redis://:redis_password_secret@localhost:6379/0

# Cloudflare R2 (para download dos PDFs)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
